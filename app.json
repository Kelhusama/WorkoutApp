{
  "expo": {
    "name": "Forja del Canario",
    "slug": "forja-canario",
    "version": "0.1.0",
    "scheme": "forja",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#14304C",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.kelhusama.forja",
      "adaptiveIcon": {
        "backgroundColor": "#0B1B2B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Forja del Canario usa la cámara para tus fotos de progreso.",
          "photosPermission": "Forja del Canario lee tus fotos para guardar las de progreso.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Forja del Canario usa la cámara para tus fotos de progreso.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "google": {
        "webClientId": "984207562493-09in3cdf2kg9ad6s89u5rmbb6rrhc7g2.apps.googleusercontent.com"
      },
      "eas": {
        "projectId": "9014ca94-1997-46ce-bb08-1afdb8440790"
      }
    },
    "owner": "kelhusamas-team"
  }
}
